<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><title>逃げろ！ニャンコ v15</title><style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#111;font-family:system-ui,"Noto Sans JP",sans-serif}body{display:flex;align-items:center;justify-content:center}#box{position:relative;width:min(100vw,960px);height:min(100vh,600px);overflow:hidden;background:#7dd4ff}canvas{width:100%;height:100%;display:block;touch-action:none}#hud{position:absolute;left:12px;right:12px;top:10px;display:flex;justify-content:space-between;color:#fff;font-weight:900;text-shadow:0 2px 4px #000;pointer-events:none}.p{background:#0007;border:2px solid #fff9;border-radius:12px;padding:6px 10px}.dist{font-size:20px}.life{font-size:18px;letter-spacing:3px;color:#ff8c00}.st{width:165px;font-size:12px}.bar{height:11px;background:#222;border-radius:8px;overflow:hidden;border:1px solid #fff}.fill{height:100%;width:100%;background:#42e36c}#msg{position:absolute;left:50%;top:25%;transform:translate(-50%,-50%);font-size:clamp(25px,5vw,48px);font-weight:1000;color:#fff;text-shadow:0 3px 7px #000;opacity:0;white-space:nowrap;z-index:4}.ov{position:absolute;inset:0;background:#0008;color:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;z-index:5;text-shadow:0 3px 7px #000}.ov h1{font-size:clamp(32px,7vw,60px);margin:0 0 10px}.ov p{margin:5px 12px;font-size:clamp(13px,2.5vw,20px)}.ov button{margin-top:14px;padding:13px 28px;border:0;border-radius:18px;font-size:18px;font-weight:900}.hidden{display:none!important}</style></head><body><div id="box"><canvas id="cv" width="960" height="600"></canvas><div id="hud"><div class="p"><div class="dist" id="dist">0 m</div><div class="life" id="life">♥ ♥</div></div><div class="p st">体力<div class="bar"><div class="fill" id="fill"></div></div></div></div><div id="msg"></div><div class="ov" id="start"><h1>逃げろ！ニャンコ</h1><p>猫は中央を一定速度で走り続けます。</p><p>体力が減るほど、犬が左端から近づきます。</p><p>開始後4秒間は落とし穴が出ません。</p><p>ゲーム画面をタップするとジャンプします。</p><p>500m以降は犬がタマを投げてきます。タマに当たるとライフが1減ります。</p><button id="startBtn">ゲームスタート</button></div><div class="ov hidden" id="over"><h1>ゲームオーバー</h1><p id="reason"></p><p id="final" style="font-size:27px;font-weight:1000"></p><button id="retry">もう一度遊ぶ</button></div></div>
<script>const DOG='data:image/png;base64,';
const CAT='data:image/png;base64,';
const dogImg=new Image(),catImg=new Image();dogImg.src=DOG;catImg.src=CAT;
const cv=document.getElementById('cv'),g=cv.getContext('2d'),W=960,H=600;
const DW=384,DH=375,CW=384,CH=384;
let running=false,last=0,raf=0,time=0,meters=0,world=0,lives=2,energy=100,pits=[],items=[],balls=[],nextPit=0,nextItem=1000,ballCool=0,audio=null;
let cat,dog,energyStart=0;
function init(){
 cat={x:405,y:0,w:165,h:145,vy:0,on:true,frame:0,ft:0,row:0,hurt:0,returning:0,coyote:0,jumpBuffer:0,jumps:0,jumpBaseY:0,maxJumpY:0};
 dog={x:30,y:0,w:175,h:140,frame:0,ft:0,row:0,mode:'run',attack:0,cool:4.5,jump:0,attackStartX:30};
 cat.y=ground(world+cat.x)-cat.h;dog.y=ground(world+dog.x)-dog.h;
}
function ground(wx){const base=468,cy=1550,q=((wx%cy)+cy)%cy;if(q<430)return base;if(q<680)return base-(q-430)*.20;if(q<950)return base-50+(q-680)*.19;if(q<1160)return base;if(q<1330)return base-(q-1160)*.17;return base-29+(q-1330)*.17}
function pitHere(wx){for(const p of pits)if(wx>p.x-8&&wx<p.x+p.w+8)return p;return null}
function reset(){running=false;time=0;meters=0;world=0;lives=2;energy=100;energyStart=0;pits=[];items=[];balls=[];nextPit=0;nextItem=1200;ballCool=0;init();updateHud();draw()}
function updateHud(){document.getElementById('dist').textContent=Math.floor(meters)+' m';document.getElementById('life').textContent='♥ '.repeat(lives).trim()+' '+('♡ '.repeat(2-lives)).trim();document.getElementById('fill').style.width=Math.max(0,energy)+'%';document.getElementById('fill').style.background=energy>55?'#42e36c':energy>25?'#ffd43b':'#ff5c5c'}
function sound(f,d,t='sine',v=.05,s=0){if(!audio)return;let o=audio.createOscillator(),a=audio.createGain(),n=audio.currentTime;o.type=t;o.frequency.setValueAtTime(f,n);o.frequency.linearRampToValueAtTime(f+s,n+d);a.gain.setValueAtTime(.0001,n);a.gain.exponentialRampToValueAtTime(v,n+.01);a.gain.exponentialRampToValueAtTime(.0001,n+d);o.connect(a).connect(audio.destination);o.start(n);o.stop(n+d+.02)}
function jumpS(){sound(520,.08,'square',.05,250);setTimeout(()=>sound(820,.08,'square',.04,-80),40)}function hitS(){sound(90,.25,'sawtooth',.09,-55)}function pitS(){sound(160,.35,'sawtooth',.09,-120)}function heartS(){sound(650,.1,'sine',.06,300);setTimeout(()=>sound(1000,.13,'sine',.05,160),70)}const churuImg=new Image();churuImg.src='data:image/png;base64,';
function churuS(){sound(730,.11,'triangle',.06,350);setTimeout(()=>sound(1120,.15,'triangle',.05,170),90)}function tamaS(){sound(180,.09,'square',.055,260);setTimeout(()=>sound(120,.12,'square',.04,-120),35)}function say(t,ms=900){let e=document.getElementById('msg');e.textContent=t;e.style.opacity=1;clearTimeout(say.t);say.t=setTimeout(()=>e.style.opacity=0,ms)}
function addPit(){let w=70+Math.random()*70;pits.push({x:nextPit,w,warning:false});nextPit+=w+900+Math.random()*550}
function addItem(){let heart=Math.random()<.4;items.push({x:nextItem,type:heart?'heart':'churu',y:ground(nextItem)-135-Math.random()*35,t:0,got:false});nextItem+=650+Math.random()*700}
function throwTama(){
  if(!running||meters<500||dog.jump>0)return;
  const sx=dog.x+dog.w-10, sy=dog.y+dog.h*.38;
  const tx=cat.x+cat.w*.5, ty=cat.y+cat.h*.45;
  const dx=tx-sx, dy=ty-sy;
  const vx=470;
  const t=Math.max(.55,Math.abs(dx)/vx);
  const vy=dy/t-0.5*900*t;
  balls.push({x:sx,y:sy,vx,vy,r:14,spin:0});
  tamaS();
}
function jump(){
 if(!running||cat.hurt>0)return;
 const gy=ground(world+cat.x);
 const feet=cat.y+cat.h;
 const nearGround=Math.abs(feet-gy)<28 && Math.abs(cat.vy)<120;
 // 1回目：通常ジャンプ。2回目：空中で追加ジャンプ。
 // 2段目は総上昇量が通常ジャンプの1.5倍を超えないよう上限を設ける。
 if(cat.on || cat.coyote>0 || nearGround){
   if(nearGround){cat.y=gy-cat.h;cat.vy=0;cat.on=true;}
   cat.vy=-760;cat.on=false;cat.coyote=0;cat.jumpBuffer=0;cat.jumps=1;
   cat.jumpBaseY=cat.y;
   cat.maxJumpY=cat.jumpBaseY-((760*760)/(2*1800))*1.5;
   jumpS();
 }else if(cat.jumps===1){
   // 2段目は通常ジャンプの約半分の高さを追加し、合計最大1.5倍。
   cat.vy=-535;cat.jumps=2;cat.on=false;cat.coyote=0;cat.jumpBuffer=0;jumpS();
 }else{
   cat.jumpBuffer=.14;
 }
}
function finish(r){if(window.stopGameBGM) window.stopGameBGM(); running=false;cancelAnimationFrame(raf);document.getElementById('reason').textContent=r;document.getElementById('final').textContent='逃げた距離：'+Math.floor(meters)+' m';document.getElementById('over').classList.remove('hidden');draw()}
function hit(){if(cat.hurt>0||!running)return;
 // 攻撃が命中した瞬間、犬を「今回の攻撃開始位置」へ強制的に戻す。
 // 体力満タンなら左端付近、体力が少ないほど猫へ近づいた位置を開始位置として保存している。
 dog.x=dog.attackStartX;dog.mode='run';dog.attack=0;dog.row=0;dog.jump=0;
 const gy=ground(world+dog.x);dog.y=gy-dog.h;
 lives--;cat.hurt=1.0;cat.frame=0;cat.row=3;balls=[];hitS();say('うぇ〜ん！',1000);updateHud();if(lives<=0){finish('犬の攻撃を2回受けました');return}}
function tamaHit(){
  if(cat.hurt>0||!running)return;
  lives--;cat.hurt=1.0;cat.frame=0;cat.row=3;balls=[];hitS();say('タマが当たった！',900);updateHud();
  if(lives<=0){finish('タマに2回当たりました');return}
}
function overlap(a,b){return a.x+a.w*.75>b.x+b.w*.2&&a.x+a.w*.2<b.x+b.w*.8&&a.y+a.h*.75>b.y+b.h*.15&&a.y+a.h*.15<b.y+b.h*.9}
function update(dt){
 // ヒット中は1秒間、ゲーム世界・体力・距離を完全停止。泣きモーションだけ再生。
 if(cat.hurt>0){cat.hurt-=dt;cat.row=3;cat.ft+=dt;if(cat.ft>.13){cat.frame=(cat.frame+1)%4;cat.ft=0}return}
 time+=dt;meters=time*10;
 // 体力は20秒で100→0。チュール取得時はその瞬間を新しいMAXとして20秒カウントをリセット。
 energy=Math.max(0,100-(time-energyStart)*5);
 updateHud();
 const speed=330;world+=speed*dt;cat.x=440;
 cat.vy+=1800*dt;cat.y+=cat.vy*dt;let gy=ground(world+cat.x);
 const wasOn=cat.on;
 if(cat.y+cat.h>=gy){cat.y=gy-cat.h;cat.vy=0;cat.on=true;cat.coyote=.14;cat.jumps=0;}
 else {cat.on=false;cat.coyote=Math.max(0,cat.coyote-dt);}
 if(cat.jumpBuffer>0){cat.jumpBuffer=Math.max(0,cat.jumpBuffer-dt);if(cat.on||cat.coyote>0){cat.vy=-760;cat.on=false;cat.coyote=0;cat.jumpBuffer=0;cat.jumps=1;cat.jumpBaseY=cat.y;cat.maxJumpY=cat.y-((760*760)/(2*1800))*1.5;jumpS();}}
 // 坂の頂点・谷で地面が急変しても、足元がほぼ接地している場合は接地状態を優先。
 if(!cat.on && Math.abs(cat.y+cat.h-gy)<10 && Math.abs(cat.vy)<180){cat.y=gy-cat.h;cat.vy=0;cat.on=true;cat.coyote=.14;}
 // 2段ジャンプの最高点を通常ジャンプの1.5倍以内に制限。
 if(cat.jumps===2 && cat.y<cat.maxJumpY){cat.y=cat.maxJumpY;if(cat.vy<0)cat.vy=0;}

 cat.row=!cat.on?1:(cat.returning>0?2:0);if(cat.returning>0){cat.returning-=dt;cat.x=440}
 cat.ft+=dt;if(cat.ft>.125){cat.frame=(cat.frame+1)%4;cat.ft=0}
 // 穴は開始4秒後から生成。必ず画面のかなり手前に予告を出し、直前出現を防止。
 if(time>=4){if(nextPit===0)nextPit=world+1200;while(nextPit<world+3000)addPit()}else nextPit=0;
 while(nextItem<world+2400)addItem();
 const cp=pitHere(world+cat.x+cat.w*.5); if(cat.on&&cp && world+cat.x+cat.w*.72>cp.x+cp.w*.28 && world+cat.x+cat.w*.28<cp.x+cp.w*.72){pitS();finish('落とし穴に落ちました');return}
 if(cat.y>H+30){pitS();finish('落とし穴に落ちました');return}
 for(const it of items){it.t+=dt;if(it.got)continue;let b={x:it.x-world-24,y:it.y-24,w:48,h:48},a={x:cat.x+18,y:cat.y+14,w:cat.w-36,h:cat.h-25};if(overlap(a,b)){it.got=true;if(it.type==='heart'){if(lives<2){lives++;}heartS()}else{energyStart=time;energy=100;cat.returning=1.0;cat.row=2;churuS()}updateHud()}}
 // 500m以降、犬が一定間隔でタマを投げる。
 if(meters>=500){
   ballCool-=dt;
   if(ballCool<=0){throwTama();ballCool=2.8+Math.random()*1.6;}
 }else{ballCool=1.5;}
 for(const b of balls){
   b.vy+=900*dt;b.x+=b.vx*dt;b.y+=b.vy*dt;b.spin+=dt*12;
   const a={x:cat.x+22,y:cat.y+18,w:cat.w-44,h:cat.h-30};
   const q={x:b.x-b.r,y:b.y-b.r,w:b.r*2,h:b.r*2};
   if(overlap(a,q)){b.dead=true;tamaHit();if(!running)break;}
 }
 balls=balls.filter(b=>!b.dead&&b.x>-100&&b.x<W+120&&b.y>-100&&b.y<H+160);
 pits=pits.filter(p=>p.x+p.w>world-400);items=items.filter(i=>i.x>world-500);
 const fatigue=1-energy/100;
 // 犬の通常位置：体力100%では初期の左端、体力が減るほど猫へ近づく。
 // ただしMINでも猫のすぐ隣にはならず、必ず少し距離を残す。
 const normalX=30+300*fatigue;dog.cool-=dt;
 // 犬がジャンプ中は攻撃できない。ジャンプが終わるまで攻撃開始も保留する。
 if(dog.mode!=='attack'&&dog.cool<=0&&dog.jump<=0){
   dog.mode='attack';dog.attack=0;dog.cool=4.0+Math.random()*2;
   // 今回の攻撃開始位置を保存。命中したらここへ即座に戻す。
   dog.attackStartX=dog.x;
 }
 if(dog.mode==='attack'){
   // 念のため、攻撃中にジャンプ状態になった場合も即座に攻撃を解除。
   if(dog.jump>0){dog.mode='run';dog.attack=0}
   else{
     dog.attack+=dt;dog.x+=(cat.x-50-dog.x)*Math.min(1,dt*1.7);dog.row=2;
     if(dog.attack>.9){if(Math.abs(dog.x-cat.x)<145&&cat.on)hit();else dog.mode='run'}
   }
 }
 if(dog.mode!=='attack'){
   dog.x+=(normalX-dog.x)*Math.min(1,dt*5);dog.row=0;
   let dp=pitHere(world+dog.x+dog.w*.4);if(dp&&dog.jump<=0)dog.jump=.82;
   if(dog.jump>0){dog.jump-=dt;dog.row=1;dog.y=ground(world+dog.x)-dog.h-150*Math.sin((.82-dog.jump)/.82*Math.PI)}
   else dog.y=ground(world+dog.x)-dog.h
 }
 dog.ft+=dt;if(dog.ft>.105){dog.frame=(dog.frame+1)%4;dog.ft=0}
 // ジャンプ中は当たり判定による攻撃も無効。
 if(dog.mode==='attack'&&dog.jump<=0&&Math.abs(dog.x-cat.x)<145&&cat.on)hit()
}
function stage(){let sky=g.createLinearGradient(0,0,0,480);sky.addColorStop(0,'#55c8ff');sky.addColorStop(1,'#d6f4ff');g.fillStyle=sky;g.fillRect(0,0,W,H);let off=(world*.18)%W;g.fillStyle='#76aa68';g.beginPath();g.moveTo(0,340);for(let i=0;i<=W;i+=50)g.lineTo(i,335+28*Math.sin((i+off)/180));g.lineTo(W,480);g.lineTo(0,480);g.fill();g.fillStyle='#a6d474';g.beginPath();g.moveTo(0,395);for(let i=0;i<=W;i+=55)g.lineTo(i,385+25*Math.sin((i+off)/220));g.lineTo(W,H);g.lineTo(0,H);g.fill();g.fillStyle='#a97855';g.beginPath();for(let i=0;i<=W;i+=8){let y=ground(world+i);if(i===0)g.moveTo(i,y);else g.lineTo(i,y)}g.lineTo(W,H);g.lineTo(0,H);g.closePath();g.fill();g.strokeStyle='#456b35';g.lineWidth=6;g.beginPath();for(let i=0;i<=W;i+=8){let y=ground(world+i);if(i===0)g.moveTo(i,y);else g.lineTo(i,y)}g.stroke();for(let i=30;i<W;i+=110){let y=ground(world+i);g.fillStyle='#6b6c65';g.beginPath();g.ellipse(i,y+24,7,4,0,0,Math.PI*2);g.fill()}}
function drawPit(p){let sx=p.x-world;if(sx>W+120||sx+p.w<-120)return;let y=ground(world+sx);g.fillStyle='#392522';g.fillRect(sx,y-5,p.w,95);g.fillStyle='#100e12';g.fillRect(sx+7,y+4,Math.max(1,p.w-14),70);g.strokeStyle='#6a4030';g.lineWidth=4;g.strokeRect(sx+1,y,p.w-2,58);
 // 穴の手前に「！」警告を表示して、突然現れたように見えないようにする
 if(sx>120&&sx<820){g.fillStyle='#fff';g.font='900 22px sans-serif';g.textAlign='center';g.fillText('！',sx-28,y-22);g.fillStyle='#e33';g.beginPath();g.arc(sx-28,y-29,16,0,Math.PI*2);g.fill();g.fillStyle='#fff';g.fillText('！',sx-28,y-22)} }
function item(it){if(it.got)return;let sx=it.x-world,sy=it.y+Math.sin(it.t*4)*7;if(sx<-100||sx>W+100)return;g.save();g.translate(sx,sy);g.textAlign='center';g.textBaseline='middle';if(it.type==='heart'){g.font='50px sans-serif';g.fillStyle='#ff4f8b';g.shadowColor='#fff';g.shadowBlur=6;g.fillText('♥',0,0)}else{if(churuImg.complete&&churuImg.naturalWidth){let iw=150,ih=71;g.drawImage(churuImg,-iw/2,-ih/2,iw,ih)}else{g.fillStyle='#2b91e8';g.fillRect(-65,-19,130,38);g.strokeStyle='#fff';g.lineWidth=3;g.strokeRect(-65,-19,130,38);g.fillStyle='#ffe600';g.font='900 20px sans-serif';g.fillText('【チュール】',0,1)}}g.restore()}
function sprite(im,row,frame,px,py,pw,ph){let sw=im===dogImg?DW:CW,sh=im===dogImg?DH:CH;g.drawImage(im,frame*sw,row*sh,sw,sh,px,py,pw,ph)}
function drawTama(b){g.save();g.translate(b.x,b.y);g.rotate(b.spin);g.fillStyle='#f7d447';g.beginPath();g.arc(0,0,b.r,0,Math.PI*2);g.fill();g.strokeStyle='#7a5a00';g.lineWidth=3;g.stroke();g.fillStyle='#fff6b0';g.beginPath();g.arc(-4,-5,4,0,Math.PI*2);g.fill();g.restore()}
function draw(){stage();for(const p of pits)drawPit(p);for(const it of items)item(it);for(const b of balls)drawTama(b);sprite(dogImg,dog.row,dog.frame,dog.x,dog.y,dog.w,dog.h);sprite(catImg,cat.row,cat.frame,cat.x,cat.y,cat.w,cat.h);if(dog.mode==='attack'){g.font='900 18px sans-serif';g.lineWidth=5;g.strokeStyle='#000';g.fillStyle='#fff';g.strokeText('ダッシュ！',dog.x,dog.y-8);g.fillText('ダッシュ！',dog.x,dog.y-8)}}
function loop(t){if(!running)return;let dt=Math.min(.033,(t-last)/1000||.016);last=t;update(dt);draw();if(running)raf=requestAnimationFrame(loop)}
function initAudio(){audio=audio||new(window.AudioContext||window.webkitAudioContext)();if(audio.state==='suspended')audio.resume()}
function start(){initAudio();reset();document.getElementById('start').classList.add('hidden');document.getElementById('over').classList.add('hidden');draw();running=true;
  if(window.startGameBGM) window.startGameBGM();last=performance.now();raf=requestAnimationFrame(loop)}
document.getElementById('startBtn').onclick=start;document.getElementById('retry').onclick=start;cv.addEventListener('pointerdown',e=>{e.preventDefault();if(running){initAudio();jump()}});addEventListener('keydown',e=>{if(e.code==='Space'||e.code==='ArrowUp'){e.preventDefault();jump()}});reset();function wait(){if(dogImg.complete&&catImg.complete)draw();else setTimeout(wait,50)}wait();</script><audio id="gameBgm" loop preload="auto" src="data:audio/mpeg;base64,"></audio>

<script>
(function(){
  const bgm = document.getElementById('gameBgm');
  if(!bgm) return;
  bgm.volume = 0.18;
  window.startGameBGM = function(){
    bgm.volume = 0.18;
    const p = bgm.play();
    if(p && p.catch) p.catch(()=>{});
  };
  window.stopGameBGM = function(){
    bgm.pause();
    try { bgm.currentTime = 0; } catch(e) {}
  };
})();
</script>


<script>
(function(){
  function hook(id){
    const el=document.getElementById(id);
    if(el && !el.dataset.bgmHooked){
      el.addEventListener('click', function(){
        if(window.startGameBGM) window.startGameBGM();
      });
      el.dataset.bgmHooked='1';
    }
  }
  hook('startBtn');
  hook('start');
  hook('retry');
  hook('restart');
})();
</script>

